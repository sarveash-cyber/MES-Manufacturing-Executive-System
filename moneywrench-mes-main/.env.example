# Copy to .env and fill in.

# Required for the agent layer (/analyze, scripts/ask.py).
# Not needed for KPI endpoints or the dashboard.
ANTHROPIC_API_KEY=

# Optional: override the database location (defaults to sqlite at <project>/data/mes.db)
# DB_URL=sqlite:////absolute/path/to/mes.db

# Optional: Kaggle credentials for downloading the open datasets via kagglehub
# KAGGLE_USERNAME=
# KAGGLE_KEY=
